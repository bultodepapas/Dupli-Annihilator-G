{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dupli-Annihilator-G",
  "version": "1.2.0",
  "identifier": "com.giuseppe.rojas.dupliannihilatorg",
  "build": {
    "beforeBuildCommand": "npm --prefix .. run build",
    "beforeDevCommand": "npm --prefix .. run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Dupli-Annihilator-G",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
