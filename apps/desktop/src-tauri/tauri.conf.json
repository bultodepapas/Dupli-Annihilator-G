{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dupli-Annihilator-G",
  "version": "2.6.0",
  "identifier": "com.giuseppe.rojas.dupliannihilatorg",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Dupli-Annihilator-G",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
