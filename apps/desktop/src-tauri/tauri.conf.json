{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dupli-Annihilator-G",
  "version": "2.9.10",
  "identifier": "com.giuseppe.rojas.dupliannihilatorg",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Dupli-Annihilator-G",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
